# Pi SaaS Platform configuration
#
# Copy this file to .env. The file is ignored by Git; never commit real secrets.

# -----------------------------------------------------------------------------
# Gateway security
# -----------------------------------------------------------------------------
# development permits the documented placeholder secrets below. Any other value
# requires non-placeholder JWT_SECRET, ENCRYPTION_KEY, RUNTIME_SHARED_SECRET and
# POSTGRES_PASSWORD before Gateway starts.
ENVIRONMENT=development

# Gateway listener. `uv run python scripts/start_gateway.py` reads these values
# when --host and --port are omitted.
# Runtime containers reach the host through host.docker.internal.  Keep this
# port firewall-restricted to trusted local/container networks.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

# HS256 signing secret for 60-minute Gateway access tokens. Use at least 32
# random bytes, for example: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_ISSUER=pi-saas
JWT_AUDIENCE=pi-saas-api

# 32 bytes encoded using URL-safe base64. It encrypts Provider API keys stored in PostgreSQL.
# Generate with:
# python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=replace-with-32-byte-url-safe-base64-key

# Gateway passes this secret to each Docker Runtime and uses it for internal bearer requests.
# It is not a Provider API key and must differ from JWT_SECRET.
RUNTIME_SHARED_SECRET=replace-with-a-long-runtime-secret

# -----------------------------------------------------------------------------
# PostgreSQL (Gateway runs on the host; Compose starts PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=replace-with-local-username
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DATABASE=pi_saas
POSTGRES_MAX_CONNECTIONS=10

# -----------------------------------------------------------------------------
# Docker Runtime orchestration
# -----------------------------------------------------------------------------
# Gateway creates one loopback-only Runtime container per user. It never builds
# or pulls this image: import it first; see docs/runtime-image.md.
# For the expanded toolchain, build/import 0.82.1-tools-20260930 on macOS and
# set this value to that tag before restarting Gateway and recreating Runtime.
RUNTIME_DOCKER_IMAGE=pi-saas-agent-runtime:0.82.1-dev
RUNTIME_DOCKER_NETWORK=pi-saas-runtime

# Relative paths resolve from the project root. Runtime source is mounted
# read-only; tenant workspaces, Pi config and JSONL live below this data root.
RUNTIME_SOURCE_DIR=agent-runtime/src
RUNTIME_DATA_HOST_ROOT=.runtime-data

# Per-container startup/stop timeouts and resource limits.
RUNTIME_START_TIMEOUT_SECONDS=30
RUNTIME_STOP_TIMEOUT_SECONDS=10
RUNTIME_MEMORY_LIMIT=1g
RUNTIME_NANO_CPUS=1000000000
RUNTIME_PIDS_LIMIT=256

# Optional direct Runtime -> Gateway RAG tool path. Leave empty to keep Agent
# Sessions without knowledge-base bindings fully compatible. The configured
# origin must be reachable from the Docker Runtime. For local Linux Docker,
# set GATEWAY_HOST=0.0.0.0 and use http://host.docker.internal:<GATEWAY_PORT>.
# Do not put credentials, query strings, or fragments in this URL.
RUNTIME_GATEWAY_BASE_URL=
RUNTIME_RAG_REQUEST_TIMEOUT_SECONDS=30
RUNTIME_RAG_RESULT_MAX_BYTES=65536

# -----------------------------------------------------------------------------
# Workspace limits
# -----------------------------------------------------------------------------
# Maximum logical Workspaces per user, including `default`. Use `unlimited` or
# an integer greater than or equal to 1.
WORKSPACE_MAX_PER_USER=unlimited

# Soft per-user limit for all files below workspaces/, measured in MB. A Chat
# that would begin at or above this total is rejected; a single bash command can
# still write past the threshold before its next request.
WORKSPACE_STORAGE_LIMIT_MB=1024

# Hard maximum for a single Workspace file upload. The Runtime streams and
# enforces this value before atomically replacing the target file.
WORKSPACE_FILE_MAX_MB=100

# -----------------------------------------------------------------------------
# Multi-tenant RAG
# -----------------------------------------------------------------------------
# File storage capability switch. `p` means PostgreSQL only; `pm` is reserved
# for a later MinIO adapter and is rejected in this release.
FILE_BASE=p
# Default parser selected when an individual document is submitted for parsing.
# Only the built-in text parser (`default`) is available in this release.
DOCUMENT_PROCESSING_SERVICE=default

# Storage capability switches checked at Gateway/worker startup. `p`, `m`, `c`
# and `q` enable PostgreSQL, Milvus, Chroma and Qdrant respectively. `p` is
# always required; use `pmcq` on a host running all four backends.
VECTOR_BASE=p
GRAPH_BASE=p

# Vector-store connections. Each external backend owns one deterministic
# collection per knowledge base: <RAG_VECTOR_COLLECTION_PREFIX>_<kb_uuid_hex>.
# Keep credentials only in the ignored .env; startup logs redact them.
RAG_VECTOR_COLLECTION_PREFIX=pi_saas_rag
RAG_VECTOR_STORE_TIMEOUT_SECONDS=10
RAG_VECTOR_STORE_BATCH_SIZE=256
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DATABASE=default
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=false

# Redis stores resumable vector and graph intermediate results. Compose creates
# this ACL user, disables Redis' default user, and persists AOF data under
# docker/volumes/redis/. Use a unique strong password outside development.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=admin
REDIS_PASSWORD=replace-with-a-long-redis-password
# Logical Redis database used exclusively by RAG cache keys.
REDIS_DATABASE=0
# Upper bound for Redis client connections held by each Gateway/worker process.
REDIS_MAX_CONNECTIONS=20
# TTL (seconds) for incomplete vector/graph chunk results; retry reuses and
# refreshes these entries. Seven days is 604800 seconds.
RAG_CACHE_TTL_SECONDS=604800
# Job lease duration (seconds). A worker that stops heartbeating is recoverable
# after this period; must be at least 30 seconds.
RAG_JOB_LEASE_SECONDS=120
# Worker polling interval in seconds for PostgreSQL's persistent job queues.
RAG_WORKER_POLL_SECONDS=1
# Maximum attempts for asynchronous knowledge-base copy/delete operations.
RAG_OPERATION_MAX_ATTEMPTS=3

# Initial per-knowledge-base concurrency for parsing, chunking, embedding and graph
# extraction. Users can lower/raise it through the RAG API up to the limits
# below.
RAG_DEFAULT_PARSING_CONCURRENCY=2
RAG_DEFAULT_CHUNKING_CONCURRENCY=2
RAG_DEFAULT_EMBEDDING_CONCURRENCY=2
RAG_DEFAULT_GRAPH_CONCURRENCY=1
# System-wide ceilings per processing stage, shared by all knowledge bases.
RAG_MAX_PARSING_CONCURRENCY=8
RAG_MAX_CHUNKING_CONCURRENCY=8
RAG_MAX_EMBEDDING_CONCURRENCY=8
RAG_MAX_GRAPH_CONCURRENCY=4

# Per-file size limit (MB) and maximum number of files accepted in one RAG
# multipart upload request.
RAG_DOCUMENT_MAX_MB=100
RAG_UPLOAD_MAX_FILES=20
# Default chunking settings copied into newly created knowledge bases. Existing
# chunks keep their task snapshot when these defaults later change.
CHUNK_MAX_TOKEN_SIZE=512
CHUNK_OVERLAP_TOKEN_SIZE=64
# Literal separator for fixed splitting; `\n\n` represents a blank line.
CHUNK_SPLIT_BY_CHARACTER=\n\n
# Default regular expression for regex splitting (paragraphs and sentence ends).
CHUNK_RE_EXPRESSION=\n{2,}|(?<=[。！？.!?])\s+
# Percentile breakpoint used by semantic splitting; range is greater than 0 and
# less than 100. Semantic splitting requires a verified embedding model.
CHUNK_BREAKPOINT_THRESHOLD=95
# Keep false in production to block non-HTTPS, loopback, private and link-local
# model URLs (SSRF protection). Development may set true for local mock models.
RAG_MODEL_BASE_URL_ALLOW_PRIVATE=false
# Timeout, retries and graph completion budget for embedding/LLM model
# validation and worker calls. The graph cap prevents overly long structured
# output from a local reasoning model.
RAG_MODEL_REQUEST_TIMEOUT_SECONDS=300
RAG_MODEL_MAX_RETRIES=1
RAG_GRAPH_MAX_OUTPUT_TOKENS=4096
# vLLM/Qwen-specific. Set true only when the compatible backend supports
# `chat_template_kwargs.enable_thinking`; generic OpenAI providers keep false.
RAG_OPENAI_CHAT_TEMPLATE_DISABLE_THINKING=false

# Optional LangSmith observability for LangChain RAG calls. Leave API key empty
# and tracing false to disable it; never commit a real key.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=pi-saas-rag

# -----------------------------------------------------------------------------
# Optional real-model Agent user-flow acceptance
# -----------------------------------------------------------------------------
# These values are consumed only by test/agent_user_flow.py. Keep real
# credentials in an untracked .env or the invoking shell; the script redacts
# both secrets from its report.
AGENT_TEST_EMAIL=
AGENT_TEST_PASSWORD=
AGENT_TEST_PROVIDER_ID=
AGENT_TEST_PROVIDER_API_KEY=
AGENT_TEST_MODEL_ID=
# Optional: omit when the selected model has no reasoning-level preference.
AGENT_TEST_THINKING_LEVEL=

# Written automatically by test/user_registration.py after a successful run.
# test/rag_user_flow.py reads these values directly from the untracked .env.
RAG_TEST_EMAIL=
RAG_TEST_PASSWORD=
# Optional real-vLLM reranker acceptance. Set all three values to exercise
# vector/hybrid reranking, runtime fallback metadata, and enable/disable flow.
RAG_TEST_RERANKER_BASE_URL=
RAG_TEST_RERANKER_MODEL=
RAG_TEST_RERANKER_API_KEY=
