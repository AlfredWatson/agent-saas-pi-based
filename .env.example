POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hpc_ai_tech
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DATABASE=pi_saas
POSTGRES_MAX_CONNECTIONS=10

JWT_SECRET=replace-with-a-long-random-jwt-secret
# Generate with: python -c 'import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
ENCRYPTION_KEY=replace-with-32-byte-url-safe-base64-key
RUNTIME_URL=http://127.0.0.1:3000
RUNTIME_SHARED_SECRET=replace-with-a-long-runtime-secret

RUNTIME_DATA_ROOT=.runtime-data

RUNTIME_BACKEND=local
RUNTIME_DOCKER_IMAGE=pi-saas-agent-runtime:0.82.1-dev
RUNTIME_DOCKER_NETWORK=pi-saas-runtime
RUNTIME_SOURCE_DIR=agent-runtime/src
RUNTIME_DATA_HOST_ROOT=.runtime-data
RUNTIME_START_TIMEOUT_SECONDS=30
RUNTIME_STOP_TIMEOUT_SECONDS=10
RUNTIME_MEMORY_LIMIT=1g
RUNTIME_NANO_CPUS=1000000000
RUNTIME_PIDS_LIMIT=256
