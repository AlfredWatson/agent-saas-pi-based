# Pi SaaS Platform configuration
#
# Copy this file to .env. The file is ignored by Git; never commit real secrets.
# Gateway loads .env automatically. Node Runtime and scripts require these values
# to be exported by the shell unless Gateway creates the Docker Runtime for them.

# -----------------------------------------------------------------------------
# Gateway runtime mode and security
# -----------------------------------------------------------------------------
# development permits the documented placeholder secrets below. Any other value
# requires non-placeholder JWT_SECRET, ENCRYPTION_KEY, RUNTIME_SHARED_SECRET and
# POSTGRES_PASSWORD before Gateway starts.
ENVIRONMENT=development

# HS256 signing secret for 60-minute Gateway access tokens. Use at least 32
# random bytes, for example: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_ISSUER=pi-saas
JWT_AUDIENCE=pi-saas-api

# 32 bytes encoded using URL-safe base64. It encrypts Provider API keys stored
# in PostgreSQL. Generate with:
# python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=replace-with-32-byte-url-safe-base64-key

# Shared bearer secret used only by Gateway-to-Runtime internal HTTP requests.
# It is not a Provider API key and must differ from JWT_SECRET.
RUNTIME_SHARED_SECRET=replace-with-a-long-runtime-secret

# -----------------------------------------------------------------------------
# PostgreSQL (Gateway connects as a host process; Compose uses USER/PASSWORD/DB)
# -----------------------------------------------------------------------------
# Use localhost while Gateway runs on the host and PostgreSQL is started by
# infra/compose.dev.yml. A future containerized Gateway would use host=postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hpc_ai_tech
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DATABASE=pi_saas

# Maximum SQLAlchemy connections held by this one Gateway process. It is not a
# PostgreSQL server setting; set it below the database server connection limit.
POSTGRES_MAX_CONNECTIONS=10

# -----------------------------------------------------------------------------
# Gateway Runtime locator
# -----------------------------------------------------------------------------
# local: one Runtime process at RUNTIME_URL (first-phase development/testing).
# docker: Gateway creates one loopback-only Runtime container per user.
RUNTIME_BACKEND=local

# Used only when RUNTIME_BACKEND=local. The Runtime process must listen here.
RUNTIME_URL=http://127.0.0.1:3000

# Used only when RUNTIME_BACKEND=docker. Gateway never builds or pulls this
# image. Import it first; see docs/runtime-image.md.
RUNTIME_DOCKER_IMAGE=pi-saas-agent-runtime:0.82.1-dev
RUNTIME_DOCKER_NETWORK=pi-saas-runtime

# Host paths used by Docker mode. Relative paths are resolved from the project
# root. Source is mounted read-only; each tenant's workspaces, Pi config and
# JSONL trajectories are stored below RUNTIME_DATA_HOST_ROOT/tenants/<user-id>.
RUNTIME_SOURCE_DIR=agent-runtime/src
RUNTIME_DATA_HOST_ROOT=.runtime-data

# Per-container startup/stop timeouts and Docker resource limits.
RUNTIME_START_TIMEOUT_SECONDS=30
RUNTIME_STOP_TIMEOUT_SECONDS=10
RUNTIME_MEMORY_LIMIT=1g
RUNTIME_NANO_CPUS=1000000000
RUNTIME_PIDS_LIMIT=256

# -----------------------------------------------------------------------------
# Direct Node Runtime process only (agent-runtime/src/config.ts)
# -----------------------------------------------------------------------------
# Gateway supplies all of these automatically when it creates a Docker Runtime.
# For a local Runtime, leave TENANT_ID empty to accept Gateway requests for many
# tenants. Set TENANT_ID only for a dedicated single-tenant Runtime container.
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=3000
TENANT_ID=

# Local Runtime data root. In Docker mode Gateway overrides it with
# /runtime-data and mounts the user-specific host data directory there.
RUNTIME_DATA_ROOT=.runtime-data

# readonly exposes read, grep, find and ls for local Faux testing. coding
# exposes Pi CLI's default built-ins: read, write, edit and bash. Docker Runtime
# always receives coding from Gateway; do not rely on this file to override it.
RUNTIME_TOOL_PROFILE=readonly

# -----------------------------------------------------------------------------
# Optional smoke-test variables (scripts/smoke_flow.py)
# -----------------------------------------------------------------------------
# These are read from the shell environment by the script; source .env before
# running it if you want to use them. Faux is free and is the default.
GATEWAY_URL=http://127.0.0.1:8000
SMOKE_PROVIDER=faux
SMOKE_PROVIDER_API_KEY=
SMOKE_MODEL_ID=
SMOKE_THINKING=

# Optional shell command run by smoke_flow.py between two chats to prove Runtime
# recovery. It is executed with shell=True; leave empty unless you control it.
SMOKE_RUNTIME_RESTART_COMMAND=
